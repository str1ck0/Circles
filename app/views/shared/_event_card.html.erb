<% background = event.photos.attached? ? url_for(event.photos.first) : asset_path("avatar/CirclesAvatar.png") %>
<%= link_to event_path(event), class: "event-card" do %>
  <div class="event-card-image" style="background-image: url(<%= background %>);"></div>
  <div class="event-card-scrim"></div>
  <div class="event-card-top">
    <span class="chip"><i class="fa-solid fa-user-group"></i> <%= event.going_count %></span>
    <span class="chip <%= 'chip-accent' if event.start_date.to_date == Date.current %>"><%= event.start_date.strftime("%b %-d") %></span>
  </div>
  <div class="event-card-bottom">
    <h3 class="event-card-title"><%= event.title.upcase %></h3>
    <p class="event-card-meta">
      <% if event.private? %><i class="fa-solid fa-lock"></i> Private · <% end %><%= event.location %>
    </p>
  </div>
<% end %>

<div data-search-users-target="users_list">
  <ul class="invite-list">
    <% users.each do |user| %>
      <li class="invite-row"
          data-controller="friend"
          data-friend-user-id-value="<%= user.id %>"
          data-friend-circle-id-value="<%= circle.id %>">
        <%= user_avatar user, class: "ring-avatar ring-avatar-xs" %>
        <span class="invite-row-name"><%= user.full_name %></span>
        <%= button_tag "Invite", type: "button", class: "btn-ghost btn-sm", data: { action: "friend#submit", "friend-target" => "button" } %>
      </li>
    <% end %>
    <% if users.empty? %>
      <li class="text-dim">Nobody left to invite.</li>
    <% end %>
  </ul>
</div>

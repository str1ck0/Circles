<% content_for :title, "Dashboard" %>
<div class="page">
  <header class="page-header">
    <div>
      <p class="eyebrow">Dashboard</p>
      <h1>Hey <%= current_user.first_name %></h1>
    </div>
    <div class="page-actions">
      <%= link_to user_path(current_user), class: "btn-ghost btn-sm" do %><i class="fa-regular fa-user"></i> View profile<% end %>
      <%= link_to edit_user_registration_path, class: "btn-ghost btn-sm" do %><i class="fa-solid fa-pen"></i> Edit profile<% end %>
    </div>
  </header>

  <div class="dash-grid">
    <section class="dash-card">
      <h2 class="section-title">Next up</h2>
      <% if @next_event %>
        <div class="dash-next">
          <%= render "shared/event_card", event: @next_event %>
          <div class="dash-next-text">
            <p class="eyebrow"><%= @next_event.start_date.strftime("%A, %-d %B") %></p>
            <p class="dash-next-rsvp">
              <% case @next_rsvp&.status
                 when "going" %><i class="fa-solid fa-check"></i> You're going
              <% when "maybe" %><i class="fa-regular fa-circle-question"></i> You said maybe
              <% when "declined" %><i class="fa-solid fa-xmark"></i> You can't make it
              <% else %><i class="fa-regular fa-envelope"></i> You're invited — RSVP on the event
              <% end %>
            </p>
            <% if @upcoming_events.size > 1 %>
              <p class="text-dim"><%= pluralize(@upcoming_events.size - 1, "more event") %> coming up.</p>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="empty-state empty-state-compact">
          <h3>Nothing on the calendar</h3>
          <p>Plan something for one of your circles.</p>
          <%= link_to "New event", new_event_path, class: "btn-ghost btn-sm" %>
        </div>
      <% end %>
    </section>

    <section class="dash-card">
      <h2 class="section-title">
        Invites
        <% if @pending_invitations.any? %><span class="unread-badge"><%= @pending_invitations.size %></span><% end %>
      </h2>
      <% if @pending_invitations.any? %>
        <% @pending_invitations.each do |invitation| %>
          <div class="invitation-card">
            <%= user_avatar invitation.inviter, class: "ring-avatar ring-avatar-sm" %>
            <p><strong><%= invitation.inviter.first_name %></strong> invited you to <strong><%= invitation.circle.name %></strong></p>
            <div class="invitation-actions">
              <%= button_to "Accept", accept_invitation_path(invitation), method: :post, class: "btn-accent btn-sm" %>
              <%= button_to "Decline", decline_invitation_path(invitation), method: :post, class: "btn-ghost btn-sm" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-dim">No pending invites.</p>
      <% end %>
      <%= link_to notifications_path, class: "dash-link" do %>
        All notifications<% if unread_notifications_count.positive? %> · <%= unread_notifications_count %> unread<% end %> <i class="fa-solid fa-arrow-right"></i>
      <% end %>
    </section>

    <section class="dash-card dash-wide">
      <h2 class="section-title">
        Your circles
        <%= link_to new_circle_path, class: "section-title-action", title: "New circle" do %><i class="fa-solid fa-plus"></i><% end %>
      </h2>
      <% if @circles.any? %>
        <div class="circle-cards">
          <% @circles.each do |circle| %>
            <%= render "shared/circle_card", circle: circle %>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state empty-state-compact">
          <h3>No circles yet</h3>
          <p>Start one for your crew, or join an open circle from the home page.</p>
          <%= link_to "New circle", new_circle_path, class: "btn-accent btn-sm" %>
        </div>
      <% end %>
    </section>

    <section class="dash-card">
      <h2 class="section-title">People</h2>
      <% if @friends.any? %>
        <div class="people-grid">
          <% @friends.each do |person| %>
            <%= link_to user_path(person), class: "people-grid-item", title: person.full_name do %>
              <%= user_avatar person, class: "ring-avatar ring-avatar-md" %>
              <span><%= person.first_name %></span>
            <% end %>
          <% end %>
        </div>
        <%= link_to users_path, class: "dash-link" do %>Find more people <i class="fa-solid fa-arrow-right"></i><% end %>
      <% else %>
        <p class="text-dim">Your circle-mates will show up here.</p>
      <% end %>
    </section>

    <section class="dash-card">
      <h2 class="section-title">Playlists</h2>
      <% if @playlists.any? %>
        <div class="playlists-grid playlists-grid-compact">
          <% @playlists.each do |playlist| %>
            <div>
              <p class="playlist-source"><%= link_to playlist.circle.name, circle_path(playlist.circle) %></p>
              <iframe title="Spotify playlist" src="https://open.spotify.com/embed/playlist/<%= playlist.embed_url %>?utm_source=generator&theme=0" width="100%" height="80" frameBorder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-dim">Join a circle to see its playlists.</p>
      <% end %>
    </section>

    <% if @discover_events.any? %>
      <section class="dash-card dash-wide">
        <h2 class="section-title">Discover events</h2>
        <div class="cards-event">
          <% @discover_events.each do |event| %>
            <%= render "shared/event_card", event: event %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>

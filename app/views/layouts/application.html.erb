<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= content_for?(:title) ? "#{yield(:title)} · Circles" : "Circles" %></title>
    <%= favicon_link_tag "favicon.svg", type: "image/svg+xml" %>
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.10.0/mapbox-gl.css" rel="stylesheet">
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.10.0/mapbox-gl.js"></script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body data-controller="cursorlight">
    <%= render "shared/flashes" %>
    <div class="mouse-cursor-gradient-tracking">
      <% if user_signed_in? %>
        <div class="app-shell">
          <%= render "shared/sidebar" %>
          <main class="app-main"><%= yield %></main>
        </div>
      <% else %>
        <%= yield %>
      <% end %>
    </div>
    <%= render "shared/footer" unless @skip_footer %>
  </body>
</html>

<% event_policy = policy(@event) %>
<% content_for :title, @event.title %>
<div class="event-page">
  <header class="event-hero">
    <div class="event-hero-media">
      <% if @event.photos.attached? %>
        <div id="eventPhotos" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-inner">
            <% @event.photos.each_with_index do |photo, index| %>
              <div class="carousel-item <%= 'active' if index.zero? %>">
                <%= image_tag photo, alt: "" %>
              </div>
            <% end %>
          </div>
          <% if @event.photos.size > 1 %>
            <button class="carousel-control-prev" type="button" data-bs-target="#eventPhotos" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#eventPhotos" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          <% end %>
        </div>
      <% else %>
        <div class="event-hero-fallback"></div>
      <% end %>
    </div>

    <div class="event-hero-body" data-controller="rsvp" data-rsvp-url-value="<%= event_user_events_url(@event) %>">
      <div class="event-hero-text">
        <p class="eyebrow">
          <%= @event.start_date.strftime("%A, %-d %B") %>
          <% if @circles.any? %> · <%= @circles.map(&:name).join(", ") %><% end %>
        </p>
        <h1><%= @event.title %></h1>
        <p class="event-hero-meta">
          <span><i class="fa-solid fa-location-dot"></i> <%= @event.location %></span>
          <span>
            <i class="fa-solid fa-user-group"></i>
            <span data-rsvp-target="count" data-status="going"><%= @rsvp_counts["going"] %></span> going ·
            <span data-rsvp-target="count" data-status="maybe"><%= @rsvp_counts["maybe"] %></span> maybe
          </span>
          <span><i class="fa-solid <%= @event.private? ? 'fa-lock' : 'fa-unlock' %>"></i> <%= @event.private? ? "Private" : "Open to the circle" %></span>
        </p>
      </div>
      <% if event_policy.rsvp? %>
        <div class="event-hero-actions">
          <p class="eyebrow">Are you in?</p>
          <div class="rsvp-group" role="group" aria-label="RSVP">
            <% { "going" => "Going", "maybe" => "Maybe", "declined" => "Can't go" }.each do |status, label| %>
              <button type="button"
                      class="rsvp-button <%= 'is-active' if @user_event&.status == status %>"
                      data-rsvp-target="button"
                      data-status="<%= status %>"
                      data-action="click->rsvp#choose"><%= label %></button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </header>

  <div class="event-layout">
    <div class="event-main">
      <% if @marker.any? %>
        <section class="event-section">
          <h2 class="section-title">Where</h2>
          <div class="event-map"
               data-controller="map"
               data-map-markers-value="<%= @marker.to_json %>"
               data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>"></div>
          <p class="text-dim mt-2 mb-0"><i class="fa-solid fa-location-dot"></i> <%= @event.location %></p>
        </section>
      <% end %>

      <% if event_policy.add_payment? %>
        <section class="event-section">
          <h2 class="section-title">Splitty</h2>
          <div class="splitty">
            <div class="splitty-balances">
              <p class="eyebrow">Balances</p>
              <% balances = @event.user_events.includes(:user).sort_by { |ue| -ue.balance.abs } %>
              <ul class="balance-list">
                <% balances.each do |user_event| %>
                  <li>
                    <%= user_avatar user_event.user, class: "ring-avatar ring-avatar-xs" %>
                    <span class="balance-name"><%= user_event.user.first_name %></span>
                    <span class="balance-amount <%= user_event.balance.positive? ? 'is-owed' : (user_event.balance.negative? ? 'is-owing' : '') %>">
                      <%= user_event.balance.positive? ? "+" : "" %>R <%= user_event.balance %>
                    </span>
                  </li>
                <% end %>
              </ul>
              <p class="text-faint splitty-hint">Positive means the group owes them; negative means they owe the group.</p>
            </div>
            <div class="splitty-form">
              <p class="eyebrow">Add a cost</p>
              <%= simple_form_for [@event, @payment] do |f| %>
                <div class="row g-2">
                  <div class="col-5"><%= f.input :amount, label: "Amount (R)", input_html: { min: 1, step: 1, inputmode: "numeric" } %></div>
                  <div class="col-7"><%= f.input :description, placeholder: "Pizza, tickets…" %></div>
                </div>
                <%= f.association :user_event, label: "Who paid?", collection: @going_user_events, label_method: :user_name, required: false, include_blank: "Pick a payer" %>
                <p class="form-label">Split between</p>
                <div class="splittee-grid">
                  <%= f.association :user_events, as: :check_boxes, collection: @going_user_events, label: false, label_method: :user_name %>
                </div>
                <%= f.button :submit, "Add to the Splitty", class: "btn-accent btn-sm" %>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>

      <section class="event-section">
        <h2 class="section-title">
          Playlists
          <% if event_policy.add_playlist? %>
            <button type="button" class="section-title-action" data-bs-toggle="modal" data-bs-target="#addPlaylist" title="Add a playlist"><i class="fa-solid fa-plus"></i></button>
          <% end %>
        </h2>
        <% if @event.event_playlists.any? %>
          <div class="playlists-grid">
            <% @event.event_playlists.each do |playlist| %>
              <iframe title="Spotify playlist" src="https://open.spotify.com/embed/playlist/<%= playlist.embed_url %>?utm_source=generator&theme=0" width="100%" height="80" frameBorder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
            <% end %>
          </div>
        <% else %>
          <p class="text-dim">No playlists yet<%= event_policy.add_playlist? ? " — add a Spotify link." : "." %></p>
        <% end %>
      </section>
    </div>

    <aside class="event-aside">
      <div class="chat-panel">
        <div class="chat-panel-header">
          <h2>Chat</h2>
          <span class="text-faint"><%= @event.title %></span>
        </div>
        <% if event_policy.chat? %>
          <div class="chat-panel-body" data-controller="chatroom-subscription" data-chatroom-subscription-channel-value="EventChatroomChannel" data-chatroom-subscription-id-value="<%= @event.id %>" data-chatroom-subscription-current-user-id-value="<%= current_user.id %>">
            <div class="messages" data-chatroom-subscription-target="messages">
              <% @event.event_messages.includes(:user).each do |event_message| %>
                <div class="message-row d-flex <%= event_message.sender?(current_user) ? 'justify-content-end' : 'justify-content-start' %>">
                  <div class="<%= event_message.sender?(current_user) ? 'sender-style' : 'receiver-style' %>">
                    <%= render "shared/chat_message", message: event_message %>
                  </div>
                </div>
              <% end %>
            </div>
            <%= simple_form_for [@event, EventMessage.new], html: { data: { action: "turbo:submit-end->chatroom-subscription#resetForm" }, class: "chat-form" } do |f| %>
              <%= f.input :content, label: false, placeholder: "Message #{@event.title}", wrapper_html: { class: "flex-grow-1 mb-0" }, input_html: { rows: 1, autocomplete: "off" } %>
              <%= f.button :submit, "Send", class: "btn-accent btn-sm" %>
            <% end %>
          </div>
        <% else %>
          <div class="chat-panel-locked">
            <i class="fa-solid fa-lock"></i>
            <p>RSVP to join the chat.</p>
          </div>
        <% end %>
      </div>

      <div class="side-panel">
        <div class="chat-panel-header"><h2>Details</h2></div>
        <dl class="detail-list">
          <div>
            <dt>Hosted by</dt>
            <dd>
              <%= link_to user_path(@event.user), class: "detail-person" do %>
                <%= user_avatar @event.user, class: "ring-avatar ring-avatar-xs" %>
                <span><%= @event.user.full_name %></span>
              <% end %>
            </dd>
          </div>
          <div>
            <dt>Starts</dt>
            <dd><%= @event.start_date.strftime("%a %-d %b %Y") %></dd>
          </div>
          <div>
            <dt>Ends</dt>
            <dd><%= @event.end_date.strftime("%a %-d %b %Y") %></dd>
          </div>
          <div>
            <dt>Visibility</dt>
            <dd><%= @event.private? ? "Private — guest list only" : "Everyone in the attached circles" %></dd>
          </div>
          <% if @circles.any? %>
            <div>
              <dt>Circles</dt>
              <dd class="detail-circles">
                <% @circles.each do |circle| %>
                  <%= render "shared/circle_avatar", circle: circle, size: "xs" %>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div class="side-panel">
        <div class="chat-panel-header">
          <h2>Guest list</h2>
          <span class="text-faint"><%= @event.user_events.size %></span>
        </div>
        <% { "going" => "Going", "maybe" => "Maybe", "invited" => "Invited", "declined" => "Can't make it" }.each do |status, heading| %>
          <% guests = @guest_list[status] || [] %>
          <% next if guests.empty? %>
          <p class="guest-list-heading"><%= heading %> · <%= guests.size %></p>
          <ul class="members-list">
            <% guests.each do |user_event| %>
              <li>
                <%= link_to user_path(user_event.user) do %>
                  <%= user_avatar user_event.user, class: "ring-avatar ring-avatar-xs" %>
                  <span><%= user_event.user.full_name %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <% if event_policy.attach_circle? && @attachable_circles.any? %>
        <div class="side-panel">
          <div class="chat-panel-header"><h2>Invite a circle</h2></div>
          <p class="text-dim side-panel-lede">Everyone in the circle lands on the guest list as invited.</p>
          <%= simple_form_for [@event, @circle_event] do |f| %>
            <%= f.association :circle, as: :radio_buttons, required: false, label: false, collection: @attachable_circles, item_wrapper_class: "form-check circle-choice" %>
            <%= f.button :submit, "Add circle", class: "btn-ghost btn-sm" %>
          <% end %>
        </div>
      <% end %>
    </aside>
  </div>

  <% if event_policy.add_playlist? %>
    <div class="modal fade" id="addPlaylist" tabindex="-1" aria-labelledby="addPlaylistLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="addPlaylistLabel"><i class="fa-brands fa-spotify"></i> Add a playlist</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <%= simple_form_for [@event, @event_playlist] do |f| %>
              <%= f.input :url, label: "Spotify playlist link", placeholder: "https://open.spotify.com/playlist/…" %>
              <%= f.button :submit, "Add playlist", class: "btn-accent" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

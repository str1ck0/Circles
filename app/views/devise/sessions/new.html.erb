<% content_for :title, "Log in" %>
<div class="auth">
  <div class="auth-card">
    <%= link_to root_path do %>
      <%= image_tag "Logo/Circles_Logo.svg", class: "auth-logo white-color", alt: "Circles" %>
    <% end %>
    <h1>Welcome back</h1>
    <p class="auth-lede">Log in to see what your circles are up to.</p>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: :false }) do |f| %>
      <div class="form-inputs">
        <%= f.input :email, required: false, autofocus: true, input_html: { autocomplete: "email" } %>
        <%= f.input :password, required: false, input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>
      <div class="form-actions">
        <%= f.button :submit, "Log in", class: "btn-accent" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>

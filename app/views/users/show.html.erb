<% content_for :title, @user.full_name %>
<div class="page">
  <div class="profile-header">
    <%= user_avatar @user, class: "ring-avatar ring-avatar-xl" %>
    <div class="profile-identity">
      <h1><%= @user.full_name %></h1>
      <% if @user.handle %>
        <p class="profile-handle"><%= @user.handle %></p>
      <% end %>
      <p class="profile-meta">Joined <%= @user.created_at.strftime("%b %Y") %> · <%= pluralize(@circles.size, "circle") %></p>
      <% if @user.bio.present? %>
        <p class="profile-bio"><%= @user.bio %></p>
      <% end %>
      <% if @user == current_user %>
        <div class="profile-actions">
          <%= link_to edit_user_registration_path, class: "btn-accent btn-sm" do %><i class="fa-solid fa-pen"></i> Edit profile<% end %>
          <%= link_to dashboard_path(current_user), class: "btn-ghost btn-sm" do %><i class="fa-solid fa-gauge-high"></i> Dashboard<% end %>
        </div>
      <% end %>
    </div>
  </div>

  <section class="feed-section">
    <h2 class="section-title"><%= @user == current_user ? "YOUR CIRCLES" : "CIRCLES" %></h2>
    <% if @circles.any? %>
      <div class="circle-cards">
        <% @circles.each do |circle| %>
          <%= render "shared/circle_card", circle: circle %>
        <% end %>
      </div>
    <% else %>
      <p class="text-dim"><%= @user == current_user ? "You haven't joined a circle yet." : "No circles you can see." %></p>
    <% end %>
  </section>

  <section class="feed-section">
    <h2 class="section-title">Upcoming events</h2>
    <% if @events.any? %>
      <%= render "shared/home-card" %>
    <% else %>
      <p class="text-dim">Nothing coming up.</p>
    <% end %>
  </section>
</div>

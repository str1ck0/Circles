<div class="profile-page">
  <div class="profile-header">
    <%= link_to "<i class='fa-solid fa-arrow-left'></i>".html_safe, root_path, class: "profile-back" %>
    <%= user_avatar @user, class: "profile-avatar" %>
    <div class="profile-identity">
      <h1><%= @user.full_name %></h1>
      <% if @user.handle %>
        <p class="profile-handle"><%= @user.handle %></p>
      <% end %>
      <p class="profile-meta">Joined <%= @user.created_at.strftime("%b %Y") %> · <%= pluralize(@circles.size, "circle") %></p>
      <% if @user.bio.present? %>
        <p class="profile-bio"><%= @user.bio %></p>
      <% end %>
      <div class="profile-actions">
        <% if @user == current_user %>
          <%= link_to "Edit profile", edit_user_registration_path, class: "btn global-button-circle-show" %>
          <%= link_to "Dashboard", dashboard_path(current_user), class: "btn global-button-circle-show is-muted" %>
        <% end %>
      </div>
    </div>
  </div>

  <section class="profile-section">
    <h5><%= @user == current_user ? "YOUR CIRCLES" : "CIRCLES" %></h5>
    <% if @circles.any? %>
      <div class="circle-grid profile-circle-grid">
        <% @circles.each do |circle| %>
          <%= render "shared/circle_avatar", circle: circle %>
        <% end %>
      </div>
    <% else %>
      <p class="profile-empty"><%= @user == current_user ? "You haven't joined a circle yet." : "No circles you can see." %></p>
    <% end %>
  </section>

  <section class="profile-section">
    <h5>UPCOMING EVENTS</h5>
    <% if @events.any? %>
      <%= render "shared/home-card" %>
    <% else %>
      <p class="profile-empty">Nothing coming up.</p>
    <% end %>
  </section>
</div>

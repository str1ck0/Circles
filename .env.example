# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# The `dotenv-rails` gem loads these automatically in development and test.

# Cloudinary — image hosting for user/circle/event photos.
# Find this on your Cloudinary dashboard as the "API environment variable".
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Mapbox — renders the map and geocodes event locations on event pages.
# Create a public access token at https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=
